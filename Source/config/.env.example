# Cấu hình mẫu cho máy chủ QR Order. Sao chép thành .env (không commit) hoặc đặt thành biến môi trường.
# Thiếu biến nào thì server dùng giá trị mặc định trong backend/src/main/resources/application.yml.

# --- MySQL (bỏ qua nếu chạy profile h2) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=qrorder
DB_USER=root
DB_PASSWORD=root

# --- Bảo mật token đăng nhập nhân viên: đổi khi triển khai thật ---
AUTH_SECRET=change-this-secret

# --- Địa chỉ công khai (tunnel / IP LAN) để tạo link VNPay và link trong mã QR ---
APP_PUBLIC_URL=

# --- VNPay sandbox: để trống thì dùng khoá sandbox mặc định của nhóm ---
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=

# --- Trợ lý gợi ý món (Gemini, tuỳ chọn): trống thì chỉ dùng gợi ý dự phòng ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
